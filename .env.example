# Base de datos
DATABASE_URL=postgresql+asyncpg://sara:sara_dev_password@localhost:5432/sara
DB_PASSWORD=sara_dev_password

# Modelos ML
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=es

# Speaker recognition
SPEAKER_SIMILARITY_THRESHOLD=0.75

# TTS
TTS_MODEL=es_ES-davefx-medium

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
